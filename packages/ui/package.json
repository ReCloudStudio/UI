{
  "name": "@recloud/ui",
  "version": "0.1.0",
  "description": "ReCloud Studio official accessible UI design system and component library",
  "type": "module",
  "license": "AGPL-3.0",
  "author": "RhenCloud <i@rhen.cloud>",
  "homepage": "https://docs.worldexecute.me/brand/design/",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.js"
    },
    "./nuxt": {
      "types": "./dist/nuxt/index.d.ts",
      "import": "./dist/nuxt/index.js"
    },
    "./theme.css": "./dist/theme.css",
    "./style.css": "./dist/style.css"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && bun run copy-css",
    "copy-css": "cp src/theme.css dist/theme.css && cp src/theme.css dist/style.css",
    "dev": "vite build --watch --emptyOutDir false",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-vue-next": "^1.0.0",
    "reka-ui": "^2.10.5",
    "tailwind-merge": "^3.0.2"
  },
  "peerDependencies": {
    "@nuxt/kit": "^4.0.0",
    "@nuxt/schema": "^4.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nuxt/kit": "^4.0.0",
    "@nuxt/schema": "^4.0.0",
    "@types/node": "^22.13.9",
    "@vitejs/plugin-vue": "^6.0.9",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^8.0.0",
    "vite-plugin-dts": "^5.1.1",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.8"
  }
}
